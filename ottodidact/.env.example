# Backend configuration only. Never copy a credential into a VITE_* variable.
# Copy to .env for first setup. The default is a key-free labelled demo.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional model controls: blank leaves the model's defaults unchanged.
# For gpt-6-luna: effort = none, low, medium (default), high, xhigh, max;
# verbosity = low, medium, high. Low verbosity shortens the visible answer;
# lower effort can reduce reasoning time. Tune these independently.
# Check model support before setting: older models may reject these controls.
OPENAI_REASONING_EFFORT=
OPENAI_VERBOSITY=
PORT=8787

# Real answers: AI_PROVIDER=openai + OPENAI_API_KEY.
# No automatic fallback to demo content occurs when real AI fails.
AI_MAX_OUTPUT_TOKENS=1800
AI_CONTEXT_CHAR_LIMIT=24000
AI_TIMEOUT_MS=45000
AI_RATE_LIMIT_PER_MINUTE=20

# Optional USD prices PER 1 MILLION tokens for YOUR configured model.
# Both must be set to enable estimates; actual input/output tokens are logged.
# Estimates include all reported input tokens, including images; cache discounts
# and provider-specific adjustments are not calculated. No prices are assumed.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
