{
  "name": "ottodidact",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop study companion with screen capture and annotated tutoring",
  "main": "dist-electron/desktop/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "npm run build:electron && wait-on http://127.0.0.1:5173 && node scripts/electron.cjs --dev",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "node scripts/electron.cjs",
    "test:desktop": "npm run build && node scripts/smoke.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "katex": "^0.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.0.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  }
}
